{
  "name": "@ted-assistant/signal",
  "version": "0.2.0",
  "description": "A small, dependency-free client for signal-cli's JSON-RPC daemon: Note to Self or a separate assistant account, quotes, reactions, groups, read receipts, typing, voice notes and files as attachments.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "workspace-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messenger": {
      "workspace-source": "./src/messenger.ts",
      "types": "./dist/messenger.d.ts",
      "default": "./dist/messenger.js"
    },
    "./testing": {
      "workspace-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "Ben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbinoy/ted-personal-assistant.git",
    "directory": "packages/signal"
  },
  "homepage": "https://github.com/bbinoy/ted-personal-assistant/tree/main/packages/signal#readme",
  "bugs": {
    "url": "https://github.com/bbinoy/ted-personal-assistant/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "signal",
    "signal-cli",
    "json-rpc",
    "signal-bot"
  ],
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build/fix-dts.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "verify-pack": "node build/verify-pack.mjs",
    "test": "node --conditions=workspace-source --test test/*.test.ts"
  },
  "dependencies": {
    "@ted-assistant/messenger": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
