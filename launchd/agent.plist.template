<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__DIR__/run.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <!-- No ProcessType=Background: macOS would throttle everything the agent starts, and local speech (Qwen)
         and transcription (whisper) then crawl or hang. Standard is fine, the agent is idle most of the time. -->
    <!-- The agent writes its own rotating, redacted log (logs/agent.log).
         launchd only keeps raw crash output that never reached that logger. -->
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/logs/launchd-stderr.log</string>
</dict>
</plist>
