{
  "name": "ted-personal-assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --conditions=workspace-source --env-file=.env src/main.ts",
    "daemon": "./run.sh",
    "typecheck": "tsc",
    "lint": "npm ci --prefix tools/lint --no-audit --no-fund --silent && node tools/lint/node_modules/eslint/bin/eslint.js -c tools/lint/eslint.config.js .",
    "test": "HARNESS_DATA_DIR=$(mktemp -d) node --conditions=workspace-source --import ./test/setup.ts --test test/*.test.ts packages/*/test/*.test.ts",
    "report": "node --conditions=workspace-source --env-file-if-exists=.env src/cli.ts report",
    "restore": "node --conditions=workspace-source --env-file-if-exists=.env src/cli.ts restore",
    "doctor": "node --conditions=workspace-source --env-file-if-exists=.env src/cli.ts doctor",
    "eval": "HARNESS_DATA_DIR=$(mktemp -d) node --conditions=workspace-source --env-file-if-exists=.env scripts/approval-eval-check.ts",
    "check:isolation": "node --conditions=workspace-source scripts/memory-isolation.ts",
    "check:secrets": "node scripts/check-secrets.ts",
    "install:launchd": "scripts/install-launchd.sh",
    "install:launchd-intake": "scripts/install-intake-launchd.sh",
    "uninstall:launchd": "scripts/uninstall-launchd.sh",
    "heartbeat-report": "node --conditions=workspace-source --env-file-if-exists=.env scripts/heartbeat-report.ts",
    "signal:hello": "node --conditions=workspace-source --env-file=.env scripts/signal-hello.ts",
    "setup:tts-qwen": "bash scripts/setup-tts-qwen.sh",
    "setup:browse": "node scripts/setup-browse.ts",
    "postinstall": "node scripts/setup-browse.ts --quiet",
    "profile": "node --conditions=workspace-source --env-file-if-exists=.env scripts/profile.ts",
    "card": "node --conditions=workspace-source --env-file-if-exists=.env scripts/card.ts",
    "openbao": "node --conditions=workspace-source --env-file-if-exists=.env scripts/openbao.ts",
    "intake": "node --conditions=workspace-source --env-file-if-exists=.env scripts/intake.ts",
    "tenants": "node --conditions=workspace-source --env-file-if-exists=.env scripts/tenants.ts",
    "retention": "node --conditions=workspace-source --env-file-if-exists=.env scripts/retention.ts",
    "convdb": "node --conditions=workspace-source --env-file-if-exists=.env scripts/convdb.ts",
    "forget": "node --conditions=workspace-source --env-file-if-exists=.env scripts/forget.ts",
    "browse:smoke": "node --conditions=workspace-source --env-file-if-exists=.env scripts/browse-smoke.ts",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/mcp": "0.0.83",
    "@resvg/resvg-js": "^2.6.2",
    "@ted-assistant/messenger": "*",
    "@ted-assistant/signal": "*",
    "@ted-assistant/speech": "*",
    "parse5": "8.0.1",
    "undici": "^8.11.2",
    "zod": "^4.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "description": "A personal assistant agent: Signal chat, an email heartbeat, and a daily brief, built on the Claude Agent SDK.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ]
}
