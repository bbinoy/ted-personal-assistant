# Copy to .env and chmod 600 .env. Never commit it.

# --- required ---------------------------------------------------------------
# Your own Signal number (international format). The agent obeys ONLY your
# "Note to Self" messages, from this number. Everything else is ignored.
SIGNAL_OWNER_NUMBER=+10000000000
# Optional: give the assistant its OWN Signal account, so you chat with a contact that has its own
# name instead of with yourself (docs/SIGNAL-ACCOUNT.md). Unset: it talks to you in Note to Self.
# SIGNAL_ACCOUNT=+10000000001      # its number, or the account key from Signal Login
# SIGNAL_OWNER_ACI=                # only if Signal hides your number from it (see the guide)

# --- identity ---------------------------------------------------------------
OWNER_NAME=Alex            # how the assistant refers to you in prompts
ASSISTANT_NAME=Ted       # what it is called
# ASSISTANT_PRESET=ted    # the personality, prompts, note categories and default schedule: a folder in assistants/ (or a full path). The values below still override its schedule

# --- authentication (pick one) ----------------------------------------------
# login   (default) your stored `claude auth login`. The only mode that can use the
#         claude.ai connectors (Notion, Google Calendar, Gmail...).
# token   a long-lived token from `claude setup-token` (inference only, no connectors)
# api-key a metered Anthropic API key (inference only, no connectors)
HARNESS_AUTH=login
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# --- mail -------------------------------------------------------------------
# mailbird (default) the local Mailbird MCP server: the heartbeat run reads the inbox, reply drafts, the daily brief by email
# none               chat only, no mail client anywhere: the heartbeat run has no mail to read, the brief is
#                    sent as a Signal summary, the model is not told it has mail, doctor reports "mail: off"
# gmail              the Gmail connector of your Claude account (HARNESS_AUTH=login), no local mail client; see docs/SETUP.md
# MAIL_PROVIDER=mailbird
# Gmail only:
# MAIL_SELF_ADDRESS=you@example.com   # your own address: the only address the brief may be emailed to
# BRIEF_EMAIL=off                     # on: the brief is also emailed to MAIL_SELF_ADDRESS (the chat summary is always sent)

# --- optional tuning (defaults shown) ---------------------------------------
# HARNESS_MODEL=sonnet           # model alias or full id for chat and groups
# HEARTBEAT_MINUTES=5            # how often the free heartbeat tick runs (no model call): it starts the look jobs (every conversation's heartbeat run) and the dream
# QUIET_START_HOUR=22            # quiet hours from here ... In them the heartbeat's unprompted posts are HELD (not sent) and delivered as one message when they end, unless the run marks one urgent; a friend's and a group's too, each in its own time zone
# QUIET_END_HOUR=7               # ... until here (local time)
# QUIET_HOURS=22:00-07:00        # the same two settings in one (whole hours); wins over the two above
# DIGEST_TIMES=12:30,18:30       # what was held back (quiet hours, /quiet, the day's cap) goes out as ONE digest at these times (each conversation's own zone), and when quiet ends; "off" = only then
# DIGEST_MAX_ITEMS=8             # lines in one digest; the rest is "and N more, ask me"
# DIGEST_SUMMARIZE=off           # on: a small helper-model call writes the owner's digest one-liners (your own chat only); code's lines when it fails or takes over 10 s
# MAX_UNPROMPTED_PER_DAY=6       # most unprompted heartbeat posts per conversation per day; more are held for one combined message the next day (urgent ones are exempt)
# MAIL_BACKLOG_DAYS=7            # first run only: inbox mail older than this is marked seen without triage
# The daily brief is a skill the heartbeat run delegates (usual time and overdue hour are words in assistants/<name>/preset.json and persona/heartbeat.md).
# CHAT_COMPACT_GROWTH_TOKENS=100000 # compact a conversation (the owner's chat and every group alike) once it has grown this much beyond its first turn (tools, skills and prompts alone are ~50k for the owner, ~10k for a group) (5000-400000)
# CHAT_COMPACT_TOKENS=150000     # only for a session saved before the baseline was recorded: compact once a turn's context passes this (10000-500000)
# DAILY_BUDGET_USD=20            # background work pauses past this (SDK cost estimate)
# More than one person (docs/SETUP.md "More than one person"; needs the assistant's own Signal account). Off: nothing changes.
# TENANTS=off                    # on: anyone may write to the assistant; a stranger gets one fixed line (no model call) and you are asked in your own chat whether to let her in; each friend is a tenant with her own folder and limits and every tool but your own private ones, running on the instance key below
# TENANT_ANTHROPIC_API_KEY=      # the key tenants run on: a SEPARATE Anthropic Console workspace key with a monthly spend limit (never your own key; not ANTHROPIC_API_KEY, which would shadow your login). Handed to a tenant's run only. Unset: friends are told the assistant is not set up for them
# TENANT_DAILY_BUDGET_USD=2      # each tenant's own daily ceiling on the instance key (her tenant.json may change it)
# INSTANCE_KEY_DAILY_USD=10      # all tenants together per day on the instance key; her own ceiling cannot lift this one (0: none may spend)
# GROUP_DAILY_BUDGET_USD=5       # one group's day on your login (default a quarter of DAILY_BUDGET_USD); past it that group is not answered until tomorrow
# TENANT_NOTICE_MINUTES=30       # a fixed reply (not set up, limit reached) to one person at most this often
# TENANT_REPLY_NOTICE_MINUTES=5  # a failure notice in a friend's own chat at most this often (she is waiting, so it is shorter)
# TENANT_KEY_NOTICE_MINUTES=180   # you hear in your own chat that the shared key (TENANT_ANTHROPIC_API_KEY) was refused or is missing at most this often, whichever friend or background run hits it
# GROUP_WARM_SLOTS=2             # warm model processes kept for the most recently active groups (0: none)
# MAX_CONCURRENT_RUNS=3          # model processes (chat, heartbeat looks, dreams, compactions) running at once; chat never waits, looks and dreams queue
# TENANT_WARM_MAX=2              # warm model processes kept for the most recently active tenants (0: none)
# LAUNCHD_LABEL=com.you.ted-personal-assistant
# HARNESS_DATA_DIR=              # advanced: where instance/, conversations/ and logs/ live (default: the repo folder; state/ holds installed software only)
# MESSENGER=signal               # the chat platform, loaded by name from packages/<name> (only signal is built; packages/messenger is the interface others implement)
# SIGNAL_PORT=7583               # local port for the signal-cli daemon
# Settings are validated when the agent starts: a typo stops it with a clear message.

# What the model can see. Every tool it sees is re-sent on every model call, so hide what your
# skills never use (saves cost and time). A skill that needs a hidden tool will fail: keep
# these in step with your skills. Defaults shown.
# HIDDEN_CONNECTORS=mcp__claude_ai_Interactive_Brokers_IBKR,mcp__claude_ai_Gmail,mcp__claude_ai_Google_Drive,mcp__claude_ai_Google_Docs,mcp__claude_ai_Claude_Docs
# GMAIL_TOOLS=search_threads,get_thread,get_message,get_draft,list_drafts,list_labels,create_draft,update_draft,reply,forward,send_message,unlabel_thread,label_thread  # Gmail only
# (One <MODULE>_TOOLS setting per module with a connector, named after the module; it replaces the module's default list. A typo stops the start.)
# NOTION_TOOLS=notion-search,notion-fetch,notion-create-pages,notion-update-page
# MAILBIRD_TOOLS=summarize_all_inboxes,list_accounts,list_folders,list_conversations,search_conversations,get_message,get_conversation,list_attachments,get_attachment_content,archive_conversation,select_conversation,reply_to_conversation,reply_all_to_conversation,create_draft,update_draft,forward_conversation,send_message_now,get_send_status,send_self_briefing

# The browser sub-task (docs/SAFETY.md, "Browse"): a sandboxed browser worker for forms and bookings, in chat, background jobs and groups.
# `npm install` installs it (npm run setup:browse downloads the Chromium into instance/browse/); a step that books, buys or sends asks first, card and login fields are never filled.
# BROWSE=on                      # off: no browse tool in any run
# BROWSE_MAX_TURNS=40            # model turns per browse run (3-200)
# BROWSE_MAX_USD=1.5             # spend cap per browse run (SDK estimate)
# BROWSE_MAX_MINUTES=10          # wall clock per run; time spent waiting for your approval is not counted
# BROWSE_MAX_COMMITS=8           # judged commit-like steps per run (Enter in a search form, book, send...); read-only ones pass the judge
# BROWSE_MAX_CONCURRENT=2        # browse runs at once, shared by you and friends (one per conversation; a run waits up to a minute for a free slot, yours first)
# CARD_CAP_PURCHASE=25           # card payments (npm run card): the most one payment may be, in the card's currency. Our own cap, besides the card issuer's. 0: no card payments
# CARD_CAP_DAY=50                # the most paid with the card in one local day (payments that were clicked count, confirmed or not)
# BROWSE_MAX_PAYMENTS=1          # card payments one browse run may start
# BROWSE_LOCALE=en-GB            # the browser's language (Accept-Language, navigator.language): an ordinary one, not the headless en-US
# BROWSE_BROWSER_PATH=           # advanced: a Chromium or Chrome executable instead of the downloaded one
# BROWSE_VISION=off              # experiment. off: the worker reads page text only. read: it may also look at a screenshot (clicks stay by element ref). click: it may also click at a point; the guard looks up the element under the point itself and judges the click like a ref click, anything it cannot resolve asks you. Costs more per step; card and login fields always ask
# BROWSE_INSTALL=1               # download the browser during npm install (else: npm run setup:browse, once)
# BROWSE_SKIP_INSTALL=1          # never download the browser, not even by npm run setup:browse

# The heartbeat run (every conversation's only proactive path: yours, each group's, each friend's with the `wake` capability): a free timer ticks every HEARTBEAT_MINUTES; when the model-chosen next look has come (10-120 min, about 30 in the
# day), ONE run reads that conversation's chat and whatever it can read (yours: mail, calendar and tasks; a friend's: her own Google or Notion if connected; a group: its notes) and acts within the normal rules (anything that sends, shares or spends still asks your phone). instance/heartbeat.jsonl
# gets one row per look (counts, no words); `npm run heartbeat-report` shows it. Roughly $0.01-0.03 per look on Haiku.
# TOOL_OUTPUT_MAX_CHARS=60000    # the most characters of one tool result the model reads (1000-1000000); the rest is cut with a hint to narrow the query
# ARCHIVE_MAX_PER_RUN=25        # the most mail one run (one look, one chat turn) may archive, whichever mail provider (1-500); the rest waits for the next look
# HEARTBEAT_MODEL=haiku          # haiku, sonnet, or a full model id

# How long an "Approve?" question waits before it counts as "no". Several can be open at once.
# APPROVAL_TIMEOUT_MINUTES=15              # asked in a chat turn (1-1440); the turn being aborted also ends it
# BACKGROUND_APPROVAL_TIMEOUT_MINUTES=120  # asked by an unattended run: a heartbeat run or its expert (1-2880)
# PENDING_ACTION_DAYS=3                   # an unattended run's call that needs approval is parked in the approval inbox (/approvals) this many days (1-30), then dropped with one line
# COMPACT_MAX_MINUTES=10                 # a compaction taking longer than this is abandoned (1-120); the failure backoff applies
# RUN_MAX_MINUTES_CHAT=40                 # wall-clock ceiling of one run in your chat and in every group (1-1440): a hung turn is aborted, logged and audited, and the usual error notice is sent. Approval waits in chat count
# RUN_MAX_MINUTES_BACKGROUND=180           # the same for the heartbeat run and its expert (1-2880); time spent waiting for an approval is NOT counted, so BACKGROUND_APPROVAL_TIMEOUT_MINUTES never cuts into it

# The approval judge: a small model that decides which questions to spare you. Every tool goes through the same path in every
# place (chat, groups, heartbeat runs and their experts, browsing): a floor set in code (payments, logins, the
# never-allowed set, group boundaries, web addresses that could carry data out), then the judge, then the question on your
# phone. The judge lets through what follows from your request or your standing tasks and is easy to undo; it asks about
# anything a mail asks for, new recipients, sharing, deleting and money. Every skipped question is logged (`npm run report`).
#   auto   the judge decides (default)
#   off    it is not used: everything that is not a plain read asks (for debugging)
# AUTO_APPROVE=auto
#
# The model behind the approval judge, the reading of your free-text replies to a question and the wording of the questions. It is the safety net and it
# talks to you, so it is not the smallest model by default. sonnet, opus, haiku or a full model id. (Gate and other small helpers stay on haiku.)
# JUDGE_MODEL=sonnet

# The nightly "dream": once a day, a model with no tools reads what you told the
# assistant since the last time and proposes changes to its memory notes (new facts, merges, expired
# notes). Code applies only what is backed by your own words, snapshots first, and announces it.
# DREAM=on                       # off to disable
# DREAM_HOUR=4                   # the dream runs on the first tick at or after this local hour, once a day (0-23)
# WEATHER=on                    # forecast and kite-spot tools with the surf-conditions skill (off: neither is offered)
# DRAW=on                       # the draw tool and skill: Ted draws diagrams and charts as SVG, rendered to a PNG without scripts, network or files (off: neither is offered)
# MEMORY_MAX_NOTES=2000        # how many notes a run may read (each note is cut at 20000 characters); set far above normal use. Every note read goes into the background runs' prompts, so a very large memory costs tokens

# Every message in the assistant's chat, yours and its (and your reactions), is logged in conversations/owner/messages.jsonl so a
# reaction can be matched to its message, the assistant can search the past, and the dream can learn from it. The log is bounded by size: past the
# limit the oldest messages are folded into one short summary written by a small model.
# MESSAGE_LOG_MB=1               # 0.01-100
# SUMMARY_WORDS=60               # length of that summary

# Pictures need no setup: Ted shrinks them (and converts iPhone HEIC) with macOS's built-in sips, then shows them to the model.
# Without sips only a small JPEG, PNG, WebP or GIF works. Up to 20 MB in, 5 pictures per turn, longest side 1568 px.

# Voice messages are transcribed on this Mac with whisper.cpp and ffmpeg (brew install whisper-cpp ffmpeg),
# using a Whisper model file (about 470 MB, multilingual):
#   mkdir -p ~/.cache/ted-personal-assistant && curl -L -o ~/.cache/ted-personal-assistant/ggml-small.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-small.bin
# WHISPER_MODEL=~/.cache/ted-personal-assistant/ggml-small.bin
# TRANSCRIBE_CONCURRENCY=2          # voice notes transcribed at once, in your chat and all groups together (1-8); more wait in line, none is skipped

# Spoken replies: the assistant may answer by voice when it fits, whatever you sent (local text to speech with
# Kokoro, nothing leaves the Mac). Needs the assistant's own Signal account and `scripts/setup-tts.sh` (about 400 MB).
# VOICE_REPLIES=on               # off to always answer in text
# TTS_VOICE=am_onyx              # any Kokoro voice: am_* American male, bm_* British male, af_*, bf_* female.
# TTS_LANGUAGES=en              # languages the voice speaks, comma separated (e.g. en,de). Voice is used only for these;
#                                # a reply detected in another language is sent as text. Widen it with a multilingual voice/provider.
# TTS_SPEED=0.95                # 0.5-2
# TTS_DIR=~/.cache/ted-personal-assistant/kokoro   # where the Kokoro model is kept (scripts/setup-tts.sh puts it there)
# Optional REMOTE speech instead of Kokoro (docs/REMOTE-TTS.md). This sends the words Ted speaks to a third party or to
# your own server; only use a cloned voice you have the rights and consent for. Keys stay in this file only.
# TTS_PROVIDER=qwen             # qwen (default: local cloned voice, no network; Kokoro speaks if it is not set up) | kokoro | elevenlabs | http
# TTS_FALLBACK=none              # none: send text when remote speech fails; kokoro: speak locally instead
# TTS_TIMEOUT_SECONDS=60
# Local voice, TTS_PROVIDER=qwen (docs/REMOTE-TTS.md; `npm run setup:tts-qwen`; Apple Silicon). With both settings below unset it uses the
# built-in synthetic sample voice (assets/voices/). Set BOTH to use your own recording (a voice you have the rights to):
# TTS_REF_AUDIO=state/voice/ref.wav   # reference recording (5-20 s), outside the repo
# TTS_REF_TEXT=state/voice/ref.txt    # what is said in it: the words or a text file path
# TTS_QWEN_DIR=state/tts-qwen        # where the Qwen voice's Python environment and model cache live (npm run setup:tts-qwen)
# TTS_QWEN_MODEL=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit
# (falls back to Kokoro by default; kept loaded, stopped after WARM_IDLE_MINUTES idle)
# ELEVENLABS_API_KEY=            # with TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# TTS_HTTP_URL=https://tts.example.com/say   # with TTS_PROVIDER=http (https; http only for localhost)
# TTS_HTTP_TOKEN=                # optional bearer token
# TTS_HTTP_VOICE=                # optional "voice" field
# TTS_HTTP_REFERENCE_ID=         # optional "reference_id": names the reference recording on YOUR server

# Group chats (needs the assistant's own Signal account): add it to any group you are in and it joins in, answering
# when @mentioned or when it fits, with NO access to your mail, calendar or notes. It shares your personality (style notes) and keeps its own notes and
# history per group.
# A group you are not a member of gets no answers. No setup needed.
# GROUP_PARTICIPATION=auto       # auto: a small model judges every message; tagged: only when @mentioned or replied to
# SETTLE_SECONDS=2              # every chat (yours and groups): wait this long after a message for a burst to end, then answer all of it as one turn.
# SETTLE_MAX_SECONDS=10          # ...but never longer than this since the burst's first message: continuous chatter is answered anyway (later messages join the next turn)
# WARM=on                        # keep warm model processes ready so an answer skips the 3 s start-up: your chat, the group that spoke last and a small one for the group gate, and one for the two approval judges (at most four, usually three, about 200 MB resident each, no tokens). off: every turn starts cold
# JUDGE_WARM_IDLE_MINUTES=10    # the approval judge's warm process is dropped after this long unused (1 to 1440)
# WARM_IDLE_MINUTES=60           # drop a warm process after this long without a message (1 to 1440); the next message then starts cold
# GATE_MAX_DELAY_SECONDS=4      # the most the group gate may delay an answer to be natural ("typing…" shows meanwhile, so long pauses only make it late); 0: never
# GROUP_LOG_MB=0.5              # each group's history, size-bounded like the main message log

# Wake-ups: on every heartbeat tick a small model looks at each conversation (your chat, every group) whose "next look" has come, or
# where something was said or a note changed, and decides whether to do something on its own ("every morning post a fun fact" in a note).
# Your chat is left alone in the quiet hours. Pause and the daily budget apply.
# WAKEUPS=on                     # off to disable the gate's looks (groups and friends; the owner's heartbeat run is not affected)

# Timing constants (defaults shown; they used to be fixed in the code). Rarely worth changing.
# GROUP_STICKY_MINUTES=30         # a group member who addressed the assistant and got no answer (paused, over budget) is dropped after this long (1-1440)
# GROUP_NOTICE_MINUTES=10         # a failure is explained in a group at most this often (0: every time)
# GROUP_MEMBER_CACHE_MINUTES=5    # how long "you are in this group" is remembered before signal-cli is asked again (0-1440)
# SLOW_REPLY_SECONDS=20           # an answer that took longer than this is threaded under the message it answers (0-600)
# REPLAY_MINUTES=30             # at start, a message of yours younger than this that was never answered (lost in a restart) is answered now; 0 turns it off (0-1440)
# ECHO_WINDOW_MINUTES=5          # text we sent that comes back within this long is our own echo, not you (1-60)
# WARM_REFRESH_MINUTES=25        # your chat's warm process is renewed this often, so it is fresh after a quiet hour (1-1440)
# NOTICE_AGE_HOURS=24            # what the assistant sent on its own stays known to the chat this long (1-168)
# COMPACT_BACKOFF_MINUTES=60     # after a failed compaction, no new try for this long (1-1440)
# COMPACT_QUIET_MINUTES=5         # a grown conversation is compacted in the background once nobody has written for this long (1-240); right after a reply only if it grew 1.5 times past the limit

# --- the secret store (OpenBao, docs/SETUP.md) --------------------------------
# None of these is a secret. The app's token and the unseal shares are in the macOS Keychain, never here.
# OPENBAO_ADDR=https://127.0.0.1:8200   # loopback only; the client refuses any other address
# OPENBAO_MOUNT=ted                     # the key-value (v2) mount; items are at <mount>/tenants/<id>/...
# OPENBAO_HOME=state/openbao            # binary, config, data, audit log, certificate (0700, git-ignored)
# OPENBAO_CACERT=state/openbao/tls/cert.pem   # the pinned certificate the client trusts (default: tls/cert.pem under OPENBAO_HOME)
# OPENBAO_ROLE=ted-owner                # the owner tenant's policy and token role
# OPENBAO_KEYCHAIN_PREFIX=ted-openbao   # names of this Mac's Keychain items
# OPENBAO_LAUNCHD_LABEL=com.you.ted-openbao
# OPENBAO_TIMEOUT_SECONDS=5
# OPENBAO_CACHE_SECONDS=30              # profile reads may come from memory this long (the card never)

# --- the intake page (src/intakeserver.ts, docs/SETUP.md "The intake page") ---------
# Off until INTAKE_BASE_URL is set: then no setup link is offered to anybody. Nothing here is a secret.
# INTAKE_BASE_URL=                      # the public https address a tunnel gives the page, like https://ted.example.ts.net (no path); links are <this>/i/<code>
# INTAKE_PORT=8787                      # the page listens on 127.0.0.1 on this port, and nowhere else (npm run intake)
# INTAKE_LINK_MINUTES=15                # how long a setup link works (once)
# INTAKE_CLIENT_IP_HEADER=x-forwarded-for  # the header the tunnel puts the visitor's address in, for the rate limits (its last entry if it is x-forwarded-for); cf-connecting-ip for Cloudflare Tunnel
# INTAKE_ALLOW_HTTP_LOOPBACK=off        # tests only: allows INTAKE_BASE_URL to be an http://127.0.0.1 address

# --- Google for friends (src/googlemcp.ts, docs/SETUP.md "Google for friends") ---------
# Off until the OAuth client is set (then every friend is offered it, nothing to grant) AND she connected her account on the intake page (INTAKE_BASE_URL above).
# Her mail and calendar are then served by a pinned third-party MCP server that this agent starts for her alone, with her own token from her own OpenBao path.
# GOOGLE_OAUTH_CLIENT_ID=               # the OAuth client of your Google Cloud project (Web application; "AI-powered agent" ticked; redirect URI <INTAKE_BASE_URL>/oauth/google/callback)
# GOOGLE_OAUTH_CLIENT_SECRET=           # a secret, like TENANT_ANTHROPIC_API_KEY: only this agent, the intake page and her server process ever see it (dropped from the environment of everything else)
# GOOGLE_MCP_COMMAND=uvx                # the third-party server's command (needs uv: brew install uv)
# GOOGLE_MCP_ARGS="--exclude-newer 2026-10-20T00:00:00Z workspace-mcp==2.1.0 --single-user --tools gmail calendar"   # PINNED by version, and --exclude-newer fixes the day the dependencies resolve to; never auto-updated. To pin a commit instead: "--from <repo url>@<commit> workspace-mcp --single-user --tools gmail calendar" (docs/SETUP.md)
# GOOGLE_OAUTH_SCOPES=                  # space-separated; the default is the minimum for the tools (Gmail modify/compose/send, Calendar events and read, her address). Fewer scopes = fewer tools work
# GOOGLE_MCP_IDLE_MINUTES=20            # a friend's server process is closed after this long unused (started again on demand). Default: the heartbeat interval + 5, at least 20, so a look within the hour finds it running (one resident process per friend with Google)
# GOOGLE_MCP_CALL_SECONDS=60            # one tool call
# GOOGLE_OAUTH_AUTH_URL=                # tests only: the consent page
# GOOGLE_OAUTH_TOKEN_URL=               # tests only: the token endpoint

# Notion for friends (docs/SETUP.md "Notion for friends"): needs NOTHING but INTAKE_BASE_URL (every friend is then offered it, nothing to grant). The instance registers itself with Notion once, the first time a friend opens a Connect Notion link.
# NOTION_MCP_URL=https://mcp.notion.com/mcp   # Notion's hosted MCP server (tests point this at a fake)
# NOTION_REFRESH_MARGIN_SECONDS=300     # an access token this close to its end is renewed first (refresh tokens rotate; the new one is stored before it is used)
# NOTION_MCP_IDLE_MINUTES=10            # a friend's connection to the hosted server is closed after this long unused
# NOTION_MCP_CALL_SECONDS=60            # one tool call
